
FROM --platform=linux/amd64 node:18-alpine AS builder

# Set the working directory inside the container
WORKDIR /app

# Copy package.json and package-lock.json first to leverage Docker caching.
# This step is only re-run if your dependencies change.
COPY package*.json ./

# Install project dependencies
RUN npm install

# This ARG will receive the value from the 'args' section in your docker-compose.yml
ARG REACT_APP_RASA_SERVER_URL
# Set the environment variable for the build process
ENV REACT_APP_RASA_SERVER_URL=$REACT_APP_RASA_SERVER_URL

# Copy the rest of your application's source code
COPY . .

# Build the production version of the React app
RUN npm run build

# --- Stage 2: Serve the App with a Production-Ready Nginx Server ---
FROM --platform=linux/amd64 nginx:stable-alpine

# Copy the custom Nginx configuration.
# This is crucial for Single Page Application (SPA) routing.
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy the built static files from the 'builder' stage to the Nginx public directory
COPY --from=builder /app/build /usr/share/nginx/html

# Expose port 80 to the outside world
EXPOSE 80

# Start Nginx in the foreground
CMD ["nginx", "-g", "daemon off;"]